{
  "expo": {
    "name": "Juba Rides Driver",
    "slug": "juba-rides-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jubarides.driver"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B6B5C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jubarides.driver"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Juba Rides Driver uses your location to send you nearby trip requests and show riders where you are."
        }
      ]
    ],
    "scheme": "jubaridesdriver"
  }
}
